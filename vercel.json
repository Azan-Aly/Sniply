{
  "version": 2,
  "builds": [
    {
      "src": "Frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "Backend/api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/Backend/api/index.js" },
    { "src": "/assets/(.*)", "dest": "/Frontend/dist/assets/$1" },
    { "src": "/favicon.ico", "dest": "/Frontend/dist/favicon.ico" },
    { "src": "/(dashboard|analytics|profile|register|login)", "dest": "/Frontend/dist/index.html" },
    { "src": "/", "dest": "/Frontend/dist/index.html" },
    { "src": "/(.*)", "dest": "/Backend/api/index.js" }
  ]
}
